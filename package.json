{
  "name": "zyklus",
  "private": true,
  "version": "0.1.0",
  "description": "PLC-Puzzlespiel mit FUP/SCL-Logik",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "dev:desktop": "npm run dev -w @zyklus/desktop",
    "build:desktop": "npm run build -w @zyklus/desktop",
    "build:web": "npm run build -w @zyklus/game"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
