{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZYKLUS",
  "version": "../../../package.json",
  "identifier": "de.zyklus.spiel",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -w @zyklus/game -- --mode desktop",
      "cwd": "../../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build -w @zyklus/game -- --mode desktop",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../game/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZYKLUS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173",
        "script-src": "'self' 'unsafe-inline' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "img-src": "'self' data: blob: http://localhost:5173",
        "font-src": "'self' data: http://localhost:5173",
        "worker-src": "'self' blob: http://localhost:5173",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Steuerungsbau nach Auftrag",
    "category": "Game",
    "copyright": "Ollleey",
    "fileAssociations": [
      {
        "ext": ["anlage"],
        "name": "ZYKLUS-Anlage",
        "description": "Anlage aus dem ZYKLUS-Sandkasten",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": ["auftrag"],
        "name": "ZYKLUS-Auftrag",
        "description": "Eigener ZYKLUS-Auftrag",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
