ORGANIZATION_BLOCK "Main"
TITLE = Main Program Sweep (Cycle)
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	// Teil erst zählen, wenn die Lichtschranke 20 ms stabil unterbrochen ist
	"Entprellen"(IN := "Lichtschranke", PT := T#20ms);
	"Teile"(CU := "Entprellen".Q, R := "Quittieren", PV := 5);
	"Karton_voll" := "Teile".Q;
END_ORGANIZATION_BLOCK
