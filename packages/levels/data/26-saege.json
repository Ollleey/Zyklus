    "sources": {
      "cpu1": "DATA_BLOCK \"Achse\"\n{ S7_Optimized_Access := 'TRUE' }\nVERSION : 0.1\nNON_RETAIN\n   VAR\n      ziel : DInt;   // Zielposition in Impulsen (2 je mm)\n      start_alt : Bool;\n   END_VAR\n\nBEGIN\n\nEND_DATA_BLOCK\n\nORGANIZATION_BLOCK \"Main\"\nTITLE = Main Program Sweep (Cycle)\n{ S7_Optimized_Access := 'TRUE' }\nVERSION : 0.1\n   VAR_TEMP\n      rest : DInt;\n   END_VAR\n\nBEGIN\n\t// jede Startflanke: 400 mm weiter\n\tIF \"Start\" AND NOT \"Achse\".start_alt THEN\n\t    \"Achse\".ziel := \"Achse\".ziel + 800;\n\tEND_IF;\n\t\"Achse\".start_alt := \"Start\";\n\t// schneller Zähler der DI 8 HF (Kanal 0) zählt den Geber\n\t#rest := \"Achse\".ziel - %ID112;\n\t\"Eilgang\" := #rest > 50;\n\t\"Schleichgang\" := #rest > 0;\nEND_ORGANIZATION_BLOCK\n"
    }
