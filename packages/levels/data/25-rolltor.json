    "sources": {
      "cpu1": "DATA_BLOCK \"Tor\"\n{ S7_Optimized_Access := 'TRUE' }\nVERSION : 0.1\nNON_RETAIN\n   VAR\n      auf : Bool;\n      zu : Bool;\n      zyklen : Int;   // Schließvorgänge für die Wartung\n   END_VAR\n\nBEGIN\n\nEND_DATA_BLOCK\n\nORGANIZATION_BLOCK \"Main\"\nTITLE = Rolltor Halle 2\n{ S7_Optimized_Access := 'TRUE' }\nVERSION : 0.1\n\nBEGIN\n\t// Rolltor Halle 2 – Programm Stand 2019\n\tIF \"Taster_Auf\" THEN\n\t    \"Tor\".auf := TRUE;\n\tEND_IF;\n\tIF \"Endlage_oben\" THEN\n\t    \"Tor\".auf := FALSE;\n\tEND_IF;\n\tIF \"Taster_Zu\" THEN\n\t    \"Tor\".zu := TRUE;\n\tEND_IF;\n\tIF \"Endlage_unten\" THEN\n\t    \"Tor\".zu := FALSE;\n\t    \"Tor\".zyklen := \"Tor\".zyklen + 1;\n\tEND_IF;\n\t// Lichtschranke unterbrochen: Tor wieder öffnen\n\tIF NOT \"Lichtschranke\" AND \"Tor\".zu THEN\n\t    \"Tor\".zu := FALSE;\n\t    \"Tor\".auf := TRUE;\n\tEND_IF;\n\t\"Motor_auf\" := \"Tor\".auf;\n\t\"Motor_zu\" := \"Tor\".zu;\n\t\"Warnleuchte\" := \"Tor\".auf;\n\t\"Warnleuchte\" := \"Tor\".zu;\nEND_ORGANIZATION_BLOCK\n"
    }
  },
